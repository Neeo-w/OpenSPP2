<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--
        Seed terminology for the Alkathiry profile. All vocabularies are
        is_system=False so the Central Committee can add/rename/deactivate codes
        from the Vocabulary UI without code changes (Absolute Dynamism).
    -->

    <!-- ============ Marital Status ============ -->
    <record id="vocab_marital_status" model="spp.vocabulary">
        <field name="name">Marital Status</field>
        <field name="namespace_uri">urn:alkathiry:vocab:marital-status</field>
        <field name="is_system">False</field>
        <field name="domain">core</field>
    </record>
    <record id="marital_single" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_marital_status" />
        <field name="code">single</field>
        <field name="display">Single</field>
        <field name="sequence">10</field>
    </record>
    <record id="marital_married" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_marital_status" />
        <field name="code">married</field>
        <field name="display">Married</field>
        <field name="sequence">20</field>
    </record>
    <record id="marital_divorced" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_marital_status" />
        <field name="code">divorced</field>
        <field name="display">Divorced</field>
        <field name="sequence">30</field>
    </record>
    <record id="marital_widowed" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_marital_status" />
        <field name="code">widowed</field>
        <field name="display">Widowed</field>
        <field name="sequence">40</field>
    </record>

