<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--
        Seed terminology for the NEW Alkathiry dimensions only. Marital status,
        occupation and income already exist in spp_registry (civil_status_id /
        occupation_id / income) and are NOT redefined here.

        All vocabularies are is_system=False so the Central Committee can
        add/rename/deactivate codes from the Vocabulary UI without code changes.
    -->

    <!-- ============ Blood Type ============ -->
    <record id="vocab_blood_type" model="spp.vocabulary">
        <field name="name">Blood Type</field>
        <field name="namespace_uri">urn:alkathiry:vocab:blood-type</field>
        <field name="is_system">False</field>
        <field name="domain">core</field>
    </record>
    <record id="blood_a_pos" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_blood_type" />
        <field name="code">a_pos</field><field name="display">A+</field><field name="sequence">10</field>
    </record>
    <record id="blood_a_neg" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_blood_type" />
        <field name="code">a_neg</field><field name="display">A-</field><field name="sequence">20</field>
    </record>
    <record id="blood_b_pos" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_blood_type" />
        <field name="code">b_pos</field><field name="display">B+</field><field name="sequence">30</field>
    </record>
    <record id="blood_b_neg" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_blood_type" />
        <field name="code">b_neg</field><field name="display">B-</field><field name="sequence">40</field>
    </record>
    <record id="blood_ab_pos" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_blood_type" />
        <field name="code">ab_pos</field><field name="display">AB+</field><field name="sequence">50</field>
    </record>
    <record id="blood_ab_neg" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_blood_type" />
        <field name="code">ab_neg</field><field name="display">AB-</field><field name="sequence">60</field>
    </record>
    <record id="blood_o_pos" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_blood_type" />
        <field name="code">o_pos</field><field name="display">O+</field><field name="sequence">70</field>
    </record>
    <record id="blood_o_neg" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_blood_type" />
        <field name="code">o_neg</field><field name="display">O-</field><field name="sequence">80</field>
    </record>

