<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--
        Tribal hierarchy levels added as codes on the EXISTING OpenSPP group-type
        vocabulary (urn:openspp:vocab:group-type). allow_all_member_type=True turns
        each level into a container that can hold sub-groups, enabling the
        group-of-groups tribal tree (neighborhood > tribe > clan > family > members).
        The admin can add/rename more levels from the Vocabulary UI.
    -->
    <record id="code_group_type_neighborhood" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="spp_vocabulary.vocab_group_type" />
        <field name="code">neighborhood</field>
        <field name="display">Neighborhood</field>
        <field name="definition">A residential locality grouping several families/clans.</field>
        <field name="allow_all_member_type">True</field>
        <field name="sequence">10</field>
    </record>
    <record id="code_group_type_grand_tribe" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="spp_vocabulary.vocab_group_type" />
        <field name="code">grand_tribe</field>
        <field name="display">Grand Tribe</field>
        <field name="definition">Top-level tribal confederation containing tribes.</field>
        <field name="allow_all_member_type">True</field>
        <field name="sequence">20</field>
    </record>
    <record id="code_group_type_tribe" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="spp_vocabulary.vocab_group_type" />
        <field name="code">tribe</field>
        <field name="display">Tribe</field>
        <field name="definition">A tribe containing clans.</field>
        <field name="allow_all_member_type">True</field>
        <field name="sequence">30</field>
    </record>
    <record id="code_group_type_clan" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="spp_vocabulary.vocab_group_type" />
        <field name="code">clan</field>
        <field name="display">Clan</field>
        <field name="definition">A clan containing families.</field>
        <field name="allow_all_member_type">True</field>
        <field name="sequence">40</field>
    </record>
</odoo>
