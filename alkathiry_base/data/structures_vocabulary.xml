<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--
        Tribal leadership ladders. The position matrix (alkathiry.tribe.position)
        uses this track to separate the parallel chains of tribal officials —
        sheikhs and aqils — each chained independently per country.

        NOTE: unions and organizations are NOT here. They are dedicated bodies
        (alkathiry.organization) whose members are individuals, with their own
        screens — not registry groups and not position tracks.
    -->
    <record id="vocab_position_track" model="spp.vocabulary">
        <field name="name">Position Track / Ladder</field>
        <field name="namespace_uri">urn:alkathiry:vocab:position-track</field>
        <field name="is_system">False</field>
        <field name="domain">core</field>
        <field name="description">Separates the parallel tribal leadership ladders (sheikhs, aqils). Each ladder is chained independently per country.</field>
    </record>
    <record id="track_sheikhs" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_position_track" />
        <field name="code">sheikhs</field><field name="display">Sheikhs Ladder</field><field name="sequence">10</field>
    </record>
    <record id="track_aqils" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_position_track" />
        <field name="code">aqils</field><field name="display">Aqils Ladder</field><field name="sequence">20</field>
    </record>
</odoo>
