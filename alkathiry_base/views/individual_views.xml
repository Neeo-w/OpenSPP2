<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_individuals_form_alk" model="ir.ui.view">
        <field name="name">alkathiry.individual.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="spp_registry.view_individuals_form" />
        <field name="arch" type="xml">
            <!-- Append into the EXISTING Profile page (no new tab). Existing fields
                 (civil_status_id, occupation_id, income, address, area_id) keep their
                 native placement and are not repeated. -->
            <xpath expr="//page[@name='profile']" position="inside">
                <separator string="Alkathiry — Community Profile" />
                <group name="alk_profile_section" col="2">
                    <group string="Community Identity">
                        <field name="alk_citizen_no" />
                        <field name="alk_tribe_node_id" />
                        <field name="alk_representative_ids" widget="many2many_tags" readonly="1" />
                    </group>
                    <group string="Demographics">
                        <field name="alk_blood_type_id" />
                        <field name="alk_education_level_id" />
                        <field name="alk_employment_status_id" />
                        <field name="alk_financial_status_id" />
                    </group>
                </group>
                <separator string="Health Record" />
                <group name="alk_health_section">
                    <field name="alk_health_status_id" />
                </group>
                <field name="alk_health_condition_ids" nolabel="1" />

                <!-- Unified affiliations: every body the citizen belongs to
                     (tribe / union / organization / activity), one list, with the
                     Body Type column so it reads grouped by kind. Driven entirely by
                     group membership, so a new body type needs no new field. -->
                <separator string="Affiliations (Tribe / Unions / Organizations)" />
                <field name="individual_membership_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="group_type_id" string="Body Type" optional="show" />
                        <field name="group" string="Body" />
                        <field name="group_area_id" string="Country / Area" optional="show" />
                        <field name="membership_type_ids" widget="many2many_tags" optional="show" />
                        <field name="start_date" optional="hide" />
                        <field name="ended_date" optional="hide" />
                        <field name="status" optional="hide" />
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
