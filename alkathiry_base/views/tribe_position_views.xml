<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- ============ Top-down org chart (hierarchy view) ============ -->
    <record id="view_alk_position_hierarchy" model="ir.ui.view">
        <field name="name">alkathiry.position.hierarchy</field>
        <field name="model">alkathiry.tribe.position</field>
        <field name="arch" type="xml">
            <hierarchy>
                <field name="parent_position_id" />
                <field name="child_ids" invisible="1" />
                <templates>
                    <t t-name="hierarchy-box">
                        <div class="o_hierarchy_node_body d-flex flex-column p-2">
                            <field name="position_id" class="fw-bold" />
                            <field name="partner_id" />
                            <field name="area_id" class="text-muted" />
                        </div>
                    </t>
                </templates>
            </hierarchy>
        </field>
    </record>

    <!-- ============ List ============ -->
    <record id="view_alk_tribe_position_list" model="ir.ui.view">
        <field name="name">alkathiry.tribe.position.list</field>
        <field name="model">alkathiry.tribe.position</field>
        <field name="arch" type="xml">
            <list string="Positions">
                <field name="track_id" />
                <field name="position_id" />
                <field name="partner_id" />
                <field name="area_id" />
                <field name="tribe_id" optional="hide" />
                <field name="organization_id" optional="hide" />
                <field name="parent_position_id" optional="hide" />
                <field name="user_id" optional="hide" />
                <field name="active" widget="boolean_toggle" />
                <button
                    name="action_clone_to_country"
                    type="object"
                    icon="fa-clone"
                    title="Clone ladder to another country"
                />
            </list>
        </field>
    </record>

    <!-- ============ Form ============ -->
    <record id="view_alk_tribe_position_form" model="ir.ui.view">
        <field name="name">alkathiry.tribe.position.form</field>
        <field name="model">alkathiry.tribe.position</field>
        <field name="arch" type="xml">
            <form string="Position">
                <header>
                    <button
                        name="action_clone_to_country"
                        type="object"
                        string="Clone ladder to country"
                        class="btn-secondary"
                    />
                </header>
                <sheet>
                    <group>
                        <group string="Ladder &amp; Body">
                            <field name="track_id" />
                            <field name="tribe_id" />
                            <field name="organization_id" />
                            <field name="area_id" />
                        </group>
                        <group string="Position &amp; Holder">
                            <field name="position_id" />
                            <field name="partner_id" />
                            <field name="user_id" />
                            <field name="parent_position_id" domain="[('track_id', '=', track_id)]" />
                        </group>
                        <group string="Validity">
                            <field name="date_start" />
                            <field name="date_end" />
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ Search ============ -->
    <record id="view_alk_tribe_position_search" model="ir.ui.view">
        <field name="name">alkathiry.tribe.position.search</field>
        <field name="model">alkathiry.tribe.position</field>
        <field name="arch" type="xml">
            <search>
                <field name="track_id" />
                <field name="position_id" />
                <field name="partner_id" />
                <field name="area_id" />
                <field name="tribe_id" />
                <field name="organization_id" />
                <separator />
                <filter name="roots" string="Ladder Tops" domain="[('parent_position_id', '=', False)]" />
                <separator />
                <filter name="g_track" string="Ladder" context="{'group_by': 'track_id'}" />
                <filter name="g_area" string="Country / Place" context="{'group_by': 'area_id'}" />
                <filter name="g_position" string="Position" context="{'group_by': 'position_id'}" />
            </search>
        </field>
    </record>

    <record id="action_alk_tribe_position" model="ir.actions.act_window">
        <field name="name">Org Chart (Ladders)</field>
        <field name="res_model">alkathiry.tribe.position</field>
        <field name="view_mode">hierarchy,list,form</field>
        <field name="search_view_id" ref="view_alk_tribe_position_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Build a top-down leadership ladder</p>
            <p>Add positions and chain them with "Reports To". Switch to the org-chart
                view to see it top-down. Use the clone button to replicate a ladder to
                another country.</p>
        </field>
    </record>

    <!-- ============ Clone wizard ============ -->
    <record id="view_alk_position_clone_form" model="ir.ui.view">
        <field name="name">alkathiry.position.clone.form</field>
        <field name="model">alkathiry.position.clone</field>
        <field name="arch" type="xml">
            <form string="Clone Ladder to Another Country">
                <group>
                    <field name="source_position_id" readonly="1" />
                    <field name="target_area_id" />
                    <field name="keep_holders" />
                </group>
                <footer>
                    <button name="action_clone" type="object" string="Clone" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
