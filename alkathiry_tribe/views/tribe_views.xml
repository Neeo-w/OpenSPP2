<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_alk_tribe_list" model="ir.ui.view">
        <field name="name">alkathiry.tribe.list</field>
        <field name="model">alkathiry.tribe</field>
        <field name="arch" type="xml">
            <list string="Lineage">
                <field name="complete_name" string="Lineage" />
                <field name="tribe_type_id" string="Level" />
                <field name="level" />
                <field name="parent_id" />
                <field name="member_count" string="Members" />
            </list>
        </field>
    </record>

    <record id="view_alk_tribe_form" model="ir.ui.view">
        <field name="name">alkathiry.tribe.form</field>
        <field name="model">alkathiry.tribe</field>
        <field name="arch" type="xml">
            <form string="Tribe / Lineage Node">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_members"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-users"
                        >
                            <field name="member_count" widget="statinfo" string="Members" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Tribe / clan / family name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="tribe_type_id" />
                            <field name="parent_id" />
                            <field name="level" readonly="1" />
                            <field name="active" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Sub-tribes" name="children">
                            <field name="child_ids">
                                <list editable="bottom">
                                    <field name="name" />
                                    <field name="tribe_type_id" />
                                    <field name="code" />
                                </list>
                            </field>
                        </page>
                        <page string="Positions" name="positions">
                            <field name="position_ids">
                                <list editable="bottom">
                                    <field name="position_id" />
                                    <field name="area_id" />
                                    <field name="user_id" />
                                    <field name="parent_position_id" optional="hide" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_alk_tribe_search" model="ir.ui.view">
        <field name="name">alkathiry.tribe.search</field>
        <field name="model">alkathiry.tribe</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
                <field name="parent_id" />
                <field name="tribe_type_id" />
                <filter name="roots" string="Top-level" domain="[('parent_id', '=', False)]" />
                <separator />
                <filter name="group_type" string="Level" context="{'group_by': 'tribe_type_id'}" />
                <filter name="group_parent" string="Parent" context="{'group_by': 'parent_id'}" />
            </search>
        </field>
    </record>

    <record id="action_alk_tribe" model="ir.actions.act_window">
        <field name="name">Lineage Tree</field>
        <field name="res_model">alkathiry.tribe</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_alk_tribe_search" />
        <field name="context">{'search_default_roots': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Build the tribal lineage tree</p>
            <p>Create the grand tribe, then add child tribes/clans/families using the
                Parent field. The lineage is independent of geography.</p>
        </field>
    </record>
</odoo>
