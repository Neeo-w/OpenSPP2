<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_alk" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.alkathiry</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Alkathiry" string="Alkathiry" name="alkathiry_project">
                    <block title="Verification Governance" name="alk_verification_block">
                        <setting string="Max Consecutive Rejections" help="X in BR-VER-03: escalate to committee after this many consecutive rejections.">
                            <field name="alk_max_consecutive_rejections" />
                        </setting>
                        <setting string="SLA Reminder (hours)" help="Remind the assigned verifier after this many hours.">
                            <field name="alk_sla_reminder_hours" />
                        </setting>
                        <setting string="SLA Auto-Escalation (hours)" help="Escalate to committee after this many hours.">
                            <field name="alk_sla_escalation_hours" />
                        </setting>
                    </block>
                    <block title="Redemption Loop" name="alk_redemption_block">
                        <setting string="Barcode / JWT TTL (seconds)" help="Lifetime of the beneficiary barcode token (default 300s).">
                            <field name="alk_barcode_token_ttl_seconds" />
                        </setting>
                        <setting string="OTP TTL (seconds)" help="Lifetime of the redemption OTP (default 120s).">
                            <field name="alk_otp_ttl_seconds" />
                        </setting>
                    </block>
                    <block title="Balance Reset" name="alk_reset_block">
                        <setting string="Daily Reset Time" help="Local time the nightly engine zeroes daily balances.">
                            <field name="alk_daily_reset_time" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_alk_config_settings" model="ir.actions.act_window">
        <field name="name">Alkathiry Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'alkathiry_project'}</field>
    </record>
</odoo>
